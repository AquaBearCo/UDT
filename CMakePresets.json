    { "name": "build-linux-armv7hf-debug", "configurePreset": "linux-armv7hf-debug" },
    { "name": "build-win-x64-release", "configurePreset": "win-x64-release" },
    { "name": "build-win-arm64-release", "configurePreset": "win-arm64-release" },
    { "name": "build-macos-arm64-release", "configurePreset": "macos-arm64-release" }
  ]
