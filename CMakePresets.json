      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-armv7hf-debug",
      "displayName": "Linux armv7hf Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-armv7hf-debug",
      "toolchainFile": "${sourceDir}/toolchains/armv7hf.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-x64-release",
      "displayName": "Windows x64 Release",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/win-x64",
      "architecture": {
        "value": "x64"
      },
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
      }
    },
    {
      "name": "win-x64-debug",
      "displayName": "Windows x64 Debug",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/win-x64-debug",
      "architecture": {
        "value": "x64"
      }
    },
    {
      "name": "win-arm64-release",
      "displayName": "Windows ARM64 Release",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/win-arm64",
      "architecture": {
        "value": "ARM64"
      },
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
      }
    }
