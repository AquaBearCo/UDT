  "buildPresets": [
    { "name": "build-linux-x64", "configurePreset": "linux-x64-release" },
    { "name": "build-linux-x64-debug", "configurePreset": "linux-x64-debug" },
    { "name": "build-linux-aarch64", "configurePreset": "linux-aarch64-release" },
