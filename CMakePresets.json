      "binaryDir": "${sourceDir}/build/linux-aarch64-debug",
      "toolchainFile": "${sourceDir}/toolchains/aarch64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-armv7hf-release",
      "displayName": "Linux armv7hf Release",
