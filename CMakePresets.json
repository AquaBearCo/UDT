    { "name": "build-linux-x64-release", "configurePreset": "linux-x64-release" },
    { "name": "build-linux-aarch64-release", "configurePreset": "linux-aarch64-release" },
    { "name": "build-linux-aarch64-debug", "configurePreset": "linux-aarch64-debug" },
