    { "name": "build-win-x64-debug", "configurePreset": "win-x64-debug" },
    { "name": "build-win-arm64", "configurePreset": "win-arm64-release" },
    { "name": "build-macos-arm64", "configurePreset": "macos-arm64-release" },
    { "name": "build-macos-arm64-debug", "configurePreset": "macos-arm64-debug" },
    
